<?xml version="1.0" ?>
<clickhouse>
  <logger>
    <level>warning</level>
    <log>/tmp/cpa-deriver-bench/server.log</log>
    <errorlog>/tmp/cpa-deriver-bench/error.log</errorlog>
  </logger>
  <path>/tmp/cpa-deriver-bench/data/</path>
  <tmp_path>/tmp/cpa-deriver-bench/tmp/</tmp_path>
  <http_port>28123</http_port>
  <tcp_port>29000</tcp_port>
  <listen_host>127.0.0.1</listen_host>
  <max_server_memory_usage>1503238553</max_server_memory_usage>
  <mark_cache_size>16777216</mark_cache_size>
  <uncompressed_cache_size>16777216</uncompressed_cache_size>
  <profiles>
    <default>
      <max_memory_usage>1073741824</max_memory_usage>
      <log_queries>1</log_queries>
      <preferred_block_size_bytes>0</preferred_block_size_bytes>
      <query_plan_optimize_lazy_materialization>0</query_plan_optimize_lazy_materialization>
    </default>
  </profiles>
  <users>
    <default>
      <password/>
      <networks>
        <ip>127.0.0.1</ip>
      </networks>
      <profile>default</profile>
      <quota>default</quota>
    </default>
  </users>
  <quotas>
    <default/>
  </quotas>
  <query_log>
    <database>system</database>
    <table>query_log</table>
    <flush_interval_milliseconds>1000</flush_interval_milliseconds>
  </query_log>
</clickhouse>
